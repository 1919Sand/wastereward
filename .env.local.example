# Public Supabase browser credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: never prefix these with NEXT_PUBLIC and never commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=admin@example.com
CONTACT_WEBHOOK_URL=

# Public WhatsApp business number in international format, digits only.
# Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919509925939
